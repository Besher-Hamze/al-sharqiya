PORT=3072
MONGODB_URI=mongodb://127.0.0.1:27017/sharqiya

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

CORS_ORIGINS=http://localhost:3070,http://localhost:3071,http://217.76.56.247:3070,http://217.76.56.247:3071

# Set false when serving the API over HTTP (local Docker). Defaults to NODE_ENV=production.
COOKIE_SECURE=false

# Seeded superadmin account. Quote the password — an unquoted '#' starts a comment.
ADMIN_EMAIL=admin@alsharqiya.ae
ADMIN_PASSWORD="Sharqiya#2026"
ADMIN_NAME=Al-Sharqiya Admin
