# Copy to `.env` in this directory before `docker compose up`.
# Generate JWT secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Quote the password — an unquoted '#' starts a comment in dotenv.
ADMIN_EMAIL=admin@alsharqiya.ae
ADMIN_PASSWORD="Sharqiya#2026"
ADMIN_NAME=Al-Sharqiya Admin

COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3018,http://localhost:3019,http://localhost,http://localhost:8081

# Baked into the Next.js images at build time (browser-facing origins).
NEXT_PUBLIC_API_URL=http://localhost:3020
NEXT_PUBLIC_ASSET_URL=http://localhost:3020
NEXT_PUBLIC_SITE_URL=http://localhost:3018
DASHBOARD_API_URL=http://localhost:3020/api/v1
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3018/en
